# Required. Create a token with @BotFather.
TELEGRAM_API_TOKEN="replace-with-a-real-bot-token"

# Telegram update delivery. Polling needs no public endpoint. Webhook mode
# terminates HTTPS at a reverse proxy and forwards to the loopback listener.
TELEGRAM_DELIVERY_MODE="polling"
TELEGRAM_WEBHOOK_PUBLIC_URL=""
TELEGRAM_WEBHOOK_LISTEN="127.0.0.1"
TELEGRAM_WEBHOOK_PORT="9001"
TELEGRAM_WEBHOOK_SECRET_TOKEN=""
TELEGRAM_WEBHOOK_IP_ADDRESS=""
TELEGRAM_WEBHOOK_MAX_CONNECTIONS="16"

# Instance identity and per-instance JSONL logging.
INSTANCE_NAME="local"
LOG_FILE=""
AUDIT_LOG_MODE="metadata"

# Telegram profile metadata synchronized at startup.
BOT_NAME="GetBible Robot"
BOT_DESCRIPTION="Read and search Scripture in Telegram with GetBible."
BOT_SHORT_DESCRIPTION="Read and search Scripture with GetBible."

# Scripture defaults.
TRANSLATION="kjv"
# Per-user translation defaults. The setup manager places this database in the
# isolated instance state directory. Leave blank only for non-persistent local
# development.
USER_PREFERENCES_FILE=""
USER_PREFERENCE_LIMIT="100000"

# The repository is the machine-readable data source.
GETBIBLE_API_BASE_URL="https://api.getbible.net"

# Every clickable Scripture/search link shown in Telegram uses this website.
GETBIBLE_WEB_BASE_URL="https://getbible.life"

WELCOME_MESSAGE="Welcome to the official getBible.net telegram bot.\n/help for more info."
HELP_MESSAGE="Available commands:\n\nYou can use a reference to get verses like:\n/bible 1 John 3:16\n/bible John 3:16-19;1 John 3:10-17\n/bible Gen 1:1-5 codex\n/bible Ps 1:1-5 aov\n\n/search grace — search and scroll through complete matching verses\n/search — configure search filters\n/help — get this help message again"
WELCOME_MESSAGE_FILE=""
HELP_MESSAGE_FILE=""

# Bounded repository and worker timeouts.
GETBIBLE_CONNECT_TIMEOUT="3.05"
GETBIBLE_READ_TIMEOUT="6"
GETBIBLE_REQUEST_RETRIES="1"
# Full translations currently reach about 31 MB. Keep a bounded 64 MiB
# repository allowance without granting search responses the same budget.
GETBIBLE_MAX_RESPONSE_BYTES="67108864"
LOOKUP_TIMEOUT="20"
LOOKUP_QUEUE_TIMEOUT="2"

# Hard request and output budgets.
MAX_INPUT_LENGTH="256"
MAX_REFERENCES="8"
MAX_VERSES_PER_REFERENCE="100"
MAX_TOTAL_VERSES="100"
MAX_OUTPUT_CHUNKS="8"
SEARCH_RESULT_LIMIT="50"
SEARCH_DEADLINE_SECONDS="5"
SEARCH_MAX_RESPONSE_BYTES="4194304"
MAX_CONCURRENT_LOOKUPS="4"
MAX_CONCURRENT_SEARCHES="1"
MAX_CONCURRENT_UPDATES="16"

# Inbound token buckets. All commands consume both a user and chat token.
USER_RATE_CAPACITY="4"
USER_RATE_REFILL_PER_SECOND="0.2"
CHAT_RATE_CAPACITY="20"
CHAT_RATE_REFILL_PER_SECOND="1"
RATE_LIMIT_CACHE_SIZE="20000"
RATE_LIMIT_NOTICE_COOLDOWN="10"

# Bounded Telegram interaction sessions and navigation metadata cache.
INTERACTION_SESSION_LIMIT="2000"
INTERACTION_TTL_SECONDS="600"
CATALOG_CACHE_TTL_SECONDS="3600"

# Upstream circuit breaker.
CIRCUIT_FAILURE_THRESHOLD="5"
CIRCUIT_RECOVERY_SECONDS="30"

# Privacy and deployment behavior. Completed /bible and /search workflows always
# remove their recorded setup conversation after Scripture is posted. This
# option controls standalone handled commands such as /start and /help.
DELETE_COMMAND_MESSAGES="false"
DROP_PENDING_UPDATES="true"
PREWARM_DEFAULT_TRANSLATION="true"
HEALTH_HOST="127.0.0.1"
HEALTH_PORT="8081"
LOG_LEVEL="INFO"
