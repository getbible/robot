[Unit]
Description=GetBible Telegram Robot (%i)
Documentation=https://github.com/getbible/robot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=45s
User=gb-%i
Group=gb-%i
WorkingDirectory=/opt/getbible-robot/%i/app
EnvironmentFile=/etc/getbible-robot/%i.env
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_INSTANCE=%i
Environment=XDG_CACHE_HOME=/var/cache/getbible-robot/%i
ExecStartPre=/opt/getbible-robot/%i/app/venv/bin/python -c "from config import Settings; Settings.from_env()"
ExecStart=/opt/getbible-robot/%i/app/venv/bin/python /opt/getbible-robot/%i/app/bot.py

Restart=on-failure
RestartPreventExitStatus=75
RestartSec=10s
TimeoutStartSec=180
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateDevices=true
PrivateIPC=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadOnlyPaths=/opt/getbible-robot/%i/app
ReadWritePaths=/var/cache/getbible-robot/%i /var/lib/getbible-robot/%i /var/log/getbible-robot/%i.jsonl
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

MemoryHigh=180M
MemoryMax=256M
MemorySwapMax=16M
OOMPolicy=stop
TasksMax=48
LimitNOFILE=512

StandardOutput=journal
StandardError=journal
SyslogIdentifier=getbible-robot-%i

[Install]
WantedBy=multi-user.target
