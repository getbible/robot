# Copy this file to .env beside compose.yaml, or export the same variables in
# the shell before running docker compose.
# Pin production to a reviewed release. Change this value deliberately during
# an upgrade; use ghcr.io/getbible/robot:edge only for pre-production testing.
ROBOT_IMAGE=ghcr.io/getbible/robot:2.1.0
TELEGRAM_API_TOKEN=replace-with-a-real-bot-token
MINI_APP_PUBLIC_URL=https://bot.example.com/getbible/production

INSTANCE_NAME=production
ROBOT_CONTAINER_NAME=getbible-robot-production
BOT_NAME=GetBible Robot
BOT_DESCRIPTION=Read and search Scripture in Telegram with GetBible.
BOT_SHORT_DESCRIPTION=Read and search Scripture with GetBible.
TRANSLATION=kjv
TELEGRAM_DELIVERY_MODE=polling
TELEGRAM_WEBHOOK_PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
AUDIT_LOG_MODE=metadata
# Raw mode records Telegram numeric IDs and resolved Mini App client IPs. Use
# pseudonymous to retain distinct-user correlation without raw identifiers.
AUDIT_IDENTITY_MODE=raw
MINI_APP_ENABLED=true
REVERSE_PROXY_MODE=external
MINI_APP_PORT=9201
MINI_APP_HOST_PORT=9201
MINI_APP_BIND_ADDRESS=127.0.0.1
# Used only when TELEGRAM_DELIVERY_MODE=webhook. In polling mode the published
# mapping has no listener behind it.
TELEGRAM_WEBHOOK_PORT=9001
TELEGRAM_WEBHOOK_HOST_PORT=9001
TELEGRAM_WEBHOOK_BIND_ADDRESS=127.0.0.1
MINI_APP_TRUSTED_PROXY_CIDRS=
MINI_APP_ACCESS_LOG=true
MINI_APP_NAVIGATION_RATE_COST=0.25
MINI_APP_IP_RATE_CAPACITY=60
MINI_APP_IP_RATE_REFILL_PER_SECOND=10
MINI_APP_SESSION_EXCHANGE_RATE_CAPACITY=10
MINI_APP_SESSION_EXCHANGE_RATE_REFILL_PER_SECOND=0.2
HEALTH_PORT=8081

# Recommended single-bot profile for a host with at least 8 GiB RAM and four
# logical CPUs (an operational proxy for i3-class or stronger hardware).
ROBOT_MEMORY_LIMIT=2g
ROBOT_MEMORY_RESERVATION=1536m
CONTAINER_INSTANCE_MEMORY_LIMIT_MB=1792
CONTAINER_INSTANCE_MEMORY_WARNING_PERCENT=80
ROBOT_CPU_LIMIT=2
ROBOT_PIDS_LIMIT=256
ROBOT_TMPFS_SIZE=16m
ROBOT_STOP_GRACE_PERIOD=45s
ROBOT_LOG_MAX_SIZE=10m
ROBOT_LOG_MAX_FILES=3
MAX_CONCURRENT_LOOKUPS=8
MAX_CONCURRENT_SEARCHES=4
MAX_CONCURRENT_UPDATES=16
CONTRIBUTION_CONTRIBUTOR_LIMIT=10000
CONTRIBUTION_EVENT_LIMIT=250000
USER_RATE_CAPACITY=4
USER_RATE_REFILL_PER_SECOND=0.2
CHAT_RATE_CAPACITY=20
CHAT_RATE_REFILL_PER_SECOND=1
RATE_LIMIT_CACHE_SIZE=2000
RATE_LIMIT_NOTICE_COOLDOWN=10
ABUSE_REJECTION_THRESHOLD=6
ABUSE_WINDOW_SECONDS=60
ABUSE_BLOCK_SECONDS=300
ABUSE_WARNING_MESSAGE=Your requests have been paused because the bot received repeated requests too quickly. Please stop repeated or automated requests and try again later.

# Retained-state and disk budgets. Raise these only after observing the related
# metrics and memory/disk pressure logs.
INTERACTION_SESSION_LIMIT=200
MINI_APP_SESSION_TTL_SECONDS=10800
MINI_APP_SESSION_LIMIT=200
MINI_APP_SESSIONS_PER_USER=2
MINI_APP_MAX_SEARCHES_PER_SESSION=2
MINI_APP_MAX_AVAILABLE_SELECTIONS=256
REFERENCE_CACHE_LIMIT=1000
CHAPTER_CACHE_LIMIT=256
SEARCH_CORPUS_LIMIT=1
TRANSLATION_CACHE_LIMIT=1
CACHE_MAX_BYTES=268435456
