{
  "openapi": "3.1.0",
  "info": {
    "title": "getBible.Life Telegram Mini App API",
    "version": "1.0.0",
    "description": "Same-origin API contract for the getBible.Life Telegram Mini App. Telegram initData is revalidated on every authenticated request. Verse text is never accepted as authoritative input for basket or post operations."
  },
  "servers": [
    {
      "url": "api/v1",
      "description": "Relative to the Mini App document base"
    }
  ],
  "security": [
    {
      "bearerAuth": [],
      "telegramInitData": []
    }
  ],
  "paths": {
    "/session": {
      "post": {
        "summary": "Create or safely recover a short-lived Mini App session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["init_data"],
                "properties": {
                  "init_data": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "launch_token": {
                    "type": ["string", "null"],
                    "minLength": 16,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A reopened Telegram WebView was rebound to its still-active owner/chat session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewSession"
                }
              }
            }
          },
          "201": {
            "description": "Validated Telegram session and initial application state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "The signed Telegram launch data has already been exchanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "get": {
        "summary": "Resume and hydrate an existing WebView-tab session",
        "responses": {
          "200": {
            "description": "Current session state with the same active bearer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "summary": "Revoke the current Mini App session",
        "description": "Revocation is serialized behind an active post so an accepted post is never interrupted halfway through.",
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/cleanup": {
      "post": {
        "summary": "Signal browser readiness and clean retained launch messages",
        "description": "Authenticates the current bearer and its original Telegram initData, then removes the bot launch prompt and ephemeral source command as one idempotent cleanup unit. The browser treats transport failure as non-fatal after a session has opened.",
        "responses": {
          "204": {
            "description": "Launch-message cleanup completed or was already complete"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Request origin is not the configured Mini App origin"
          }
        }
      }
    },
    "/translations": {
      "get": {
        "summary": "List available Bible translations",
        "responses": {
          "200": {
            "description": "Translation catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["selected", "items"],
                  "properties": {
                    "selected": {
                      "$ref": "#/components/schemas/TranslationCode"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 1000,
                      "items": {
                        "$ref": "#/components/schemas/Translation"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/preferences": {
      "put": {
        "summary": "Persist validated preferences for the Telegram user",
        "description": "The sole writer for preferred translation and reader location. The complete update is validated before it is committed atomically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical persisted preferences",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["preferences"],
                  "properties": {
                    "preferences": {
                      "$ref": "#/components/schemas/Preferences"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/books": {
      "get": {
        "summary": "List books available for a translation",
        "parameters": [
          {
            "$ref": "#/components/parameters/TranslationQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical book order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["translation", "items"],
                  "properties": {
                    "translation": {
                      "$ref": "#/components/schemas/TranslationCode"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 200,
                      "items": {
                        "$ref": "#/components/schemas/Book"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/chapters": {
      "get": {
        "summary": "List chapters available for a book",
        "parameters": [
          {
            "$ref": "#/components/parameters/TranslationQuery"
          },
          {
            "name": "book",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available chapters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["translation", "book", "items"],
                  "properties": {
                    "translation": {
                      "$ref": "#/components/schemas/TranslationCode"
                    },
                    "book": {
                      "$ref": "#/components/schemas/Book"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 500,
                      "items": {
                        "$ref": "#/components/schemas/Chapter"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/scripture": {
      "post": {
        "summary": "Load one canonical chapter for reading and selection",
        "description": "Read-only chapter retrieval. Loading Scripture does not change durable translation or reader preferences.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["translation", "book", "chapter"],
                "properties": {
                  "translation": {
                    "$ref": "#/components/schemas/TranslationCode"
                  },
                  "book": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "chapter": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "verse": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000,
                    "default": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chapter verses with server-issued selection identifiers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "translation",
                    "book",
                    "chapter",
                    "reference",
                    "target_verse",
                    "sha",
                    "navigation",
                    "items"
                  ],
                  "properties": {
                    "translation": {
                      "$ref": "#/components/schemas/TranslationCode"
                    },
                    "book": {
                      "$ref": "#/components/schemas/Book"
                    },
                    "chapter": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "target_verse": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2000
                    },
                    "sha": {
                      "type": "string",
                      "minLength": 40,
                      "maxLength": 40,
                      "pattern": "^[A-Fa-f0-9]+$"
                    },
                    "navigation": {
                      "$ref": "#/components/schemas/ChapterNavigation"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 250,
                      "items": {
                        "$ref": "#/components/schemas/Verse"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "summary": "Start a bounded Scripture search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["query", "options"],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "options": {
                    "$ref": "#/components/schemas/SearchFilters"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/SearchPage"
          },
          "422": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/search/{search_id}": {
      "get": {
        "summary": "Read a page from an authenticated search result set",
        "parameters": [
          {
            "name": "search_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/SearchPage"
          },
          "404": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      }
    },
    "/basket": {
      "get": {
        "summary": "Read the server-held selection basket",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Basket"
          }
        }
      },
      "delete": {
        "summary": "Clear the server-held selection basket",
        "responses": {
          "204": {
            "description": "Basket cleared"
          }
        }
      }
    },
    "/basket/items": {
      "post": {
        "summary": "Add one server-issued verse selection",
        "description": "The server resolves selection_id to canonical repository data. The client cannot supply verse text.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["selection_id"],
                "properties": {
                  "selection_id": {
                    "$ref": "#/components/schemas/SelectionId"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Basket"
          },
          "409": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      }
    },
    "/basket/order": {
      "patch": {
        "summary": "Set the posting order for the current basket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["selection_ids"],
                "properties": {
                  "selection_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/components/schemas/SelectionId"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Basket"
          },
          "409": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      }
    },
    "/basket/items/{selection_id}": {
      "delete": {
        "summary": "Remove one verse from the current basket",
        "parameters": [
          {
            "name": "selection_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SelectionId"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Basket"
          }
        }
      }
    },
    "/post": {
      "post": {
        "summary": "Atomically validate and post the browser selection through the bot",
        "description": "The browser submits only bounded coordinate identities. The server validates every book, chapter, and verse and never accepts client-provided Scripture text or references.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["idempotency_key", "selection_ids"],
                "properties": {
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 64,
                    "pattern": "^[A-Fa-f0-9-]+$"
                  },
                  "selection_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^gbd_[a-z0-9][a-z0-9._-]{0,63}_[0-9]{3}_[0-9]{4}_[0-9]{4}$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scripture was posted exactly once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "message_ids", "idempotent_replay"],
                  "properties": {
                    "status": {
                      "const": "posted"
                    },
                    "message_ids": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "idempotent_replay": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Server-issued URL-safe opaque token matching ^[A-Za-z0-9_-]{16,128}$."
      },
      "telegramInitData": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Telegram-Init-Data",
        "description": "Raw Telegram WebApp.initData. Never log or persist this value."
      }
    },
    "parameters": {
      "TranslationQuery": {
        "name": "translation",
        "in": "query",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/TranslationCode"
        }
      }
    },
    "responses": {
      "Basket": {
        "description": "Authoritative server-held basket",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Basket"
            }
          }
        }
      },
      "SearchPage": {
        "description": "Bounded search result page",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SearchPage"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Telegram launch data or bearer session is invalid or expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "InvalidRequest": {
        "description": "The bounded request was invalid, stale, or conflicted with server state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "RateLimited": {
        "description": "The per-user or per-chat rate limit was reached",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "TranslationCode": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,29}$"
      },
      "SelectionId": {
        "type": "string",
        "minLength": 16,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$",
        "description": "Opaque, server-issued identifier bound to the authenticated session and canonical verse."
      },
      "Translation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "language", "lang", "direction"],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "lang": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,7}$",
            "description": "BCP-47 language tag used to resolve the Mini App interface catalog."
          },
          "direction": {
            "type": "string",
            "enum": ["ltr", "rtl"],
            "description": "Reading direction applied to the selected translation and interface."
          }
        }
      },
      "Book": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "name", "testament"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "testament": {
            "type": ["string", "null"],
            "enum": ["old", "new", "other", null]
          }
        }
      },
      "Chapter": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "verses"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "verses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 250,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            }
          }
        }
      },
      "ChapterLocation": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "required": ["book", "book_name", "chapter"],
        "properties": {
          "book": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "book_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "ChapterNavigation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["previous", "next"],
        "properties": {
          "previous": {
            "$ref": "#/components/schemas/ChapterLocation"
          },
          "next": {
            "$ref": "#/components/schemas/ChapterLocation"
          }
        }
      },
      "Highlight": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        },
        "description": "Half-open UTF-16 offsets into text."
      },
      "Verse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_id",
          "translation",
          "reference",
          "book_number",
          "book_name",
          "chapter",
          "verse",
          "text",
          "terms"
        ],
        "properties": {
          "selection_id": {
            "$ref": "#/components/schemas/SelectionId"
          },
          "translation": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "book_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "book_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "verse": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Display text is additionally limited to 4096 UTF-8 bytes."
          },
          "terms": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      },
      "Basket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "count", "maximum"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Verse"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "maximum": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      },
      "SearchFilters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "translation",
          "words",
          "match",
          "scope",
          "case_sensitive",
          "diacritics",
          "sort",
          "books",
          "exclude",
          "proximity"
        ],
        "properties": {
          "translation": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "words": {
            "type": "string",
            "enum": ["all", "any", "phrase"]
          },
          "match": {
            "type": "string",
            "enum": ["whole_word", "substring"]
          },
          "scope": {
            "type": "string",
            "enum": ["bible", "old_testament", "new_testament", "deuterocanon"]
          },
          "case_sensitive": {
            "type": "boolean"
          },
          "diacritics": {
            "type": "string",
            "enum": ["fold", "exact"],
            "default": "fold",
            "description": "Folding removes accents, vowel pointing and precomposed letters so unaccented Greek, unpointed Hebrew and unvowelled Arabic reach the text. The Librarian 1.x spellings \"insensitive\" and \"sensitive\" are still accepted on request and map to \"fold\" and \"exact\"; responses always use the current vocabulary."
          },
          "sort": {
            "type": "string",
            "enum": ["canonical", "relevance"]
          },
          "books": {
            "type": "array",
            "maxItems": 200,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "exclude": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "proximity": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "Preferences": {
        "type": "object",
        "additionalProperties": false,
        "required": ["translation", "search_defaults", "reader_location"],
        "properties": {
          "translation": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "search_defaults": {
            "$ref": "#/components/schemas/SearchDefaults"
          },
          "reader_location": {
            "$ref": "#/components/schemas/ReaderLocation"
          }
        }
      },
      "PreferenceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "translation": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "search_defaults": {
            "$ref": "#/components/schemas/SearchDefaults"
          },
          "reader_location": {
            "$ref": "#/components/schemas/ReaderLocation"
          }
        }
      },
      "ReaderLocation": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "required": ["translation", "book", "chapter", "verse"],
        "properties": {
          "translation": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "book": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "verse": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        }
      },
      "SearchDefaults": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "words",
          "match",
          "scope",
          "case_sensitive",
          "diacritics",
          "sort"
        ],
        "properties": {
          "words": {
            "type": "string",
            "enum": ["all", "any", "phrase"]
          },
          "match": {
            "type": "string",
            "enum": ["whole_word", "substring"]
          },
          "scope": {
            "type": "string",
            "enum": ["bible", "old_testament", "new_testament", "deuterocanon"]
          },
          "case_sensitive": {
            "type": "boolean"
          },
          "diacritics": {
            "type": "string",
            "enum": ["fold", "exact"],
            "default": "fold",
            "description": "Folding removes accents, vowel pointing and precomposed letters so unaccented Greek, unpointed Hebrew and unvowelled Arabic reach the text. The Librarian 1.x spellings \"insensitive\" and \"sensitive\" are still accepted on request and map to \"fold\" and \"exact\"; responses always use the current vocabulary."
          },
          "sort": {
            "type": "string",
            "enum": ["canonical", "relevance"]
          }
        }
      },
      "Entrypoint": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route"],
        "properties": {
          "route": {
            "type": "string",
            "enum": ["home", "search", "bible", "selection"]
          },
          "query": {
            "type": "string",
            "maxLength": 240
          },
          "reference": {
            "type": "string",
            "maxLength": 180
          },
          "translation": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "book": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "SessionState": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "preferences", "entrypoint", "translations", "basket"],
        "properties": {
          "user": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "entrypoint": {
            "$ref": "#/components/schemas/Entrypoint"
          },
          "translations": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/Translation"
            }
          },
          "basket": {
            "$ref": "#/components/schemas/Basket"
          }
        }
      },
      "NewSession": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionState"
          },
          {
            "type": "object",
            "required": ["session_token", "expires_in"],
            "properties": {
              "session_token": {
                "type": "string",
                "minLength": 16,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "expires_in": {
                "type": "integer",
                "minimum": 60,
                "maximum": 86400
              }
            }
          }
        ]
      },
      "SearchPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "search_id",
          "query",
          "translation",
          "total",
          "available",
          "truncated",
          "page",
          "page_count",
          "items"
        ],
        "properties": {
          "search_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "translation": {
            "$ref": "#/components/schemas/TranslationCode"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "available": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "truncated": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/Verse"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "retry_after": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
